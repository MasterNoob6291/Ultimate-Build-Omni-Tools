local function checkPassword()
    if attempts >= MAX_ATTEMPTS then return end

    local input     = inputBox.Text
    local inputHash = sha256(SALT .. input)

    attempts = attempts + 1
    attemptsLabel.Text = "Attempts: " .. attempts .. " / 5"

    if inputHash == STORED_HASH then
        statusLabel.Text      = "✅ Success!"
        statusLabel.TextColor3 = Color3.fromRGB(100, 220, 100)
        print("SUCCESS")
        task.delay(1.5, function()
            screenGui:Destroy()
        end)
    else
        inputBox.Text = ""
        statusLabel.TextColor3 = Color3.fromRGB(220, 80, 80)

        if attempts >= MAX_ATTEMPTS then
            statusLabel.Text = "❌ Too many attempts!"
            print("FAIL - max attempts")
            task.delay(1, function()
                script:Destroy()
            end)
        else
            local left = MAX_ATTEMPTS - attempts
            statusLabel.Text = "❌ Wrong! " .. left .. " left"
            print("FAIL - attempt " .. attempts)
        end
    end
end

